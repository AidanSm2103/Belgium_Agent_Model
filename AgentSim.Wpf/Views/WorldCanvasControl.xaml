<UserControl x:Class="AgentSim.Wpf.Views.WorldCanvasControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Canvas x:Name="WorldCanvas"
                Background="{StaticResource WorldBgBrush}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"/>

        <!-- Shown until the first Setup, so the app never opens on a blank box -->
        <StackPanel x:Name="EmptyHint"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False">
            <TextBlock Text="&#xE774;"
                       FontFamily="{StaticResource IconFont}"
                       FontSize="40"
                       Foreground="{StaticResource LineStrongBrush}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Press Setup to create the world"
                       Margin="0,10,0,0"
                       FontSize="14"
                       Foreground="{StaticResource TextMutedBrush}"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
