<UserControl x:Class="AgentSim.Wpf.Views.RulesEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AgentSim.Wpf.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="380" d:DesignWidth="318">

    <UserControl.Resources>
        <!-- Shared by the compact editor and the expanded pop-up -->
        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{StaticResource SuccessDimBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="Background" Value="{StaticResource RedDimBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusMessage}" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="Foreground" Value="#FF7A84"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: icon, title, language badge, expand button -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource CardIcon}" Text="&#xE70F;"/>
                <TextBlock Style="{StaticResource CardTitle}" Text="Scripting"/>
                <Border Margin="10,0,0,0" Padding="7,1" CornerRadius="5" VerticalAlignment="Center"
                        Background="{StaticResource GoldDimBrush}">
                    <TextBlock Text="C#" FontSize="11" FontWeight="Bold" Foreground="{StaticResource GoldBrush}"/>
                </Border>
            </StackPanel>
            <Button x:Name="ExpandButton"
                    Style="{StaticResource IconButton}"
                    Content="&#xE740;"
                    HorizontalAlignment="Right"
                    Click="ExpandButton_Click"
                    ToolTip="Open a larger editor"/>
        </Grid>

        <TextBox Grid.Row="1"
                 Style="{StaticResource CodeBox}"
                 Text="{Binding ScriptText, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Species target selector: "All" (default) applies to every
             agent, same as before. Picking a specific species applies
             the script only to agents tagged with that species. -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Apply to" Foreground="{StaticResource TextSecondaryBrush}"
                       VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding AvailableTargets}"
                      SelectedItem="{Binding TargetSpecies}"/>
            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE72C;" Margin="6,0,0,0"
                    Command="{Binding RefreshTargetsCommand}"
                    ToolTip="Refresh target list (after changing group settings and Setup)"/>
        </Grid>

        <Button Grid.Row="3" Style="{StaticResource PrimaryButton}"
                Command="{Binding ApplyCommand}" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE73E;"
                           Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="Apply behavior" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <Border Grid.Row="4" Style="{StaticResource StatusPill}">
            <TextBlock Style="{StaticResource StatusText}" Text="{Binding StatusMessage}"/>
        </Border>

        <!-- Expanded editor: a Popup floats in its own layer above the
             window, so opening/closing it never resizes or shifts any
             other control on the page. Bound to the same ScriptText,
             ApplyCommand, TargetSpecies etc. as the compact view above,
             so they always stay in sync with zero extra code. -->
        <views:NonTopmostPopup x:Name="ExpandedPopup"
               Placement="Center"
               StaysOpen="True"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Margin="28"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource GoldBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="20"
                    Width="780"
                    Height="620"
                    TextElement.Foreground="{StaticResource TextPrimaryBrush}"
                    TextElement.FontSize="13">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.65" Color="Black"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource CardIcon}" Text="&#xE70F;"/>
                            <TextBlock Text="Scripting Editor" FontSize="17" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <Border Margin="10,0,0,0" Padding="7,1" CornerRadius="5" VerticalAlignment="Center"
                                    Background="{StaticResource GoldDimBrush}">
                                <TextBlock Text="C#" FontSize="11" FontWeight="Bold" Foreground="{StaticResource GoldBrush}"/>
                            </Border>
                        </StackPanel>
                        <Button Style="{StaticResource IconButton}" Content="&#xE711;"
                                HorizontalAlignment="Right"
                                Click="CollapseButton_Click"
                                ToolTip="Close"/>
                    </Grid>

                    <TextBox Grid.Row="1"
                             Style="{StaticResource CodeBox}"
                             FontSize="14"
                             Padding="14"
                             Text="{Binding ScriptText, UpdateSourceTrigger=PropertyChanged}"/>

                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Apply to" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableTargets}"
                                  SelectedItem="{Binding TargetSpecies}"/>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE72C;" Margin="6,0,0,0"
                                Command="{Binding RefreshTargetsCommand}"
                                ToolTip="Refresh target list"/>
                    </Grid>

                    <Button Grid.Row="3" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ApplyCommand}" Margin="0,14,0,0" Padding="14,11">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE73E;"
                                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Apply behavior" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Grid.Row="4" Style="{StaticResource StatusPill}">
                        <TextBlock Style="{StaticResource StatusText}" Text="{Binding StatusMessage}"/>
                    </Border>
                </Grid>
            </Border>
        </views:NonTopmostPopup>
    </Grid>
</UserControl>
