<UserControl x:Class="AgentSim.Wpf.Views.RulesEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="250">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header row: title on the left, expand button on the right -->
        <Grid Grid.Row="0" Margin="0,0,0,5">
            <TextBlock Text="Scripting Editor (C#)" FontWeight="Bold" HorizontalAlignment="Left"/>
            <Button x:Name="ExpandButton"
                    Content="&#x26F6;"
                    Width="24" Height="24" Padding="0"
                    FontSize="14"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="ExpandButton_Click"
                    ToolTip="Expand editor"/>
        </Grid>

        <TextBox Grid.Row="1" 
                 Text="{Binding ScriptText, UpdateSourceTrigger=PropertyChanged}" 
                 AcceptsReturn="True" 
                 AcceptsTab="True"
                 FontFamily="Consolas" 
                 VerticalScrollBarVisibility="Auto" 
                 HorizontalScrollBarVisibility="Auto" />

        <!-- Species target selector: "All" (default) applies to every
             agent, same as before. Picking a specific species applies
             the script only to agents tagged with that species. -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
            <TextBlock Text="Apply to:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox ItemsSource="{Binding AvailableTargets}"
                      SelectedItem="{Binding TargetSpecies}"
                      Width="120"/>
            <Button Content="&#x21BB;" Width="24" Height="24" Padding="0" Margin="5,0,0,0"
                    Command="{Binding RefreshTargetsCommand}"
                    ToolTip="Refresh target list (after changing group settings and Setup)"/>
        </StackPanel>

        <Button Grid.Row="3" Content="Apply Behavior" Command="{Binding ApplyCommand}" Margin="0,10,0,5" Padding="5"/>

        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" TextWrapping="Wrap" FontWeight="SemiBold">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="Green"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="Foreground" Value="Red"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Expanded editor: a Popup floats in its own layer above the
             window, so opening/closing it never resizes or shifts any
             other control on the page. Bound to the same ScriptText,
             ApplyCommand, TargetSpecies etc. as the compact view above,
             so they always stay in sync with zero extra code. -->
        <Popup x:Name="ExpandedPopup"
               Placement="Center"
               StaysOpen="True"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Background="White"
                    BorderBrush="#0078D7"
                    BorderThickness="2"
                    CornerRadius="8"
                    Padding="15"
                    Width="700"
                    Height="580">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="5" Opacity="0.4"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Scripting Editor (C#)" FontWeight="Bold" FontSize="16" HorizontalAlignment="Left"/>
                        <Button Content="&#x2715;"
                                Width="28" Height="28" Padding="0"
                                HorizontalAlignment="Right"
                                Click="CollapseButton_Click"
                                ToolTip="Collapse editor"/>
                    </Grid>

                    <TextBox Grid.Row="1"
                             Text="{Binding ScriptText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             FontFamily="Consolas"
                             FontSize="14"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"/>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Apply to:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox ItemsSource="{Binding AvailableTargets}"
                                  SelectedItem="{Binding TargetSpecies}"
                                  Width="150"/>
                        <Button Content="&#x21BB;" Width="26" Height="26" Padding="0" Margin="5,0,0,0"
                                Command="{Binding RefreshTargetsCommand}"
                                ToolTip="Refresh target list"/>
                    </StackPanel>

                    <Button Grid.Row="3" Content="Apply Behavior" Command="{Binding ApplyCommand}" Margin="0,10,0,5" Padding="8"/>

                    <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" TextWrapping="Wrap" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="Green"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Foreground" Value="Red"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
