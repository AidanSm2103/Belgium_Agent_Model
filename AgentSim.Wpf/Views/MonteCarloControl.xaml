<UserControl x:Class="AgentSim.Wpf.Views.MonteCarloControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="318">
    <StackPanel>

        <!-- Header -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <!-- Small bar-chart icon drawn as a shape -->
            <Path Data="M 1,14 L 1,7 L 5,7 L 5,14 Z M 7,14 L 7,2 L 11,2 L 11,14 Z M 13,14 L 13,9 L 17,9 L 17,14 Z"
                  Fill="{StaticResource GoldBrush}"
                  VerticalAlignment="Center"
                  Margin="0,0,10,0"/>
            <TextBlock Style="{StaticResource CardTitle}" Text="Monte Carlo"/>
        </StackPanel>

        <!-- Inputs -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Trials"/>
                <TextBox Text="{Binding TrialCount, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Ticks per trial"/>
                <TextBox Text="{Binding TicksPerTrial, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </Grid>

        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,4"
                   Text="Start count variance (% per trial, 0 = none)"/>
        <TextBox Text="{Binding StartVariancePercent, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Style="{StaticResource Hint}"
                   Text="e.g. 10% of 30 agents: each trial starts with 27 to 33."/>

        <!-- Actions -->
        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource PrimaryButton}" Command="{Binding RunCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE768;"
                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Run Monte Carlo" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Command="{Binding ExportCommand}" ToolTip="Save per-trial results and a summary file as CSV">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE896;"
                               Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock Text="CSV" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Running indicator -->
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
            <Ellipse Width="9" Height="9" Fill="{StaticResource GoldBrush}" Margin="0,0,9,0" VerticalAlignment="Center">
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.2" Duration="0:0:0.6"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>
            <TextBlock Text="Running trials..." Foreground="{StaticResource GoldBrush}" FontWeight="SemiBold"/>
        </StackPanel>

        <!-- Headline numbers (appear after the first run) -->
        <Grid Margin="0,16,0,0" Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource StatTile}">
                <StackPanel>
                    <TextBlock Style="{StaticResource StatLabel}" Text="MEAN FINAL"/>
                    <TextBlock Style="{StaticResource StatValue}" FontSize="19" Text="{Binding MeanFinalText}"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource StatTile}">
                <StackPanel>
                    <TextBlock Style="{StaticResource StatLabel}" Text="95% CI"/>
                    <TextBlock Style="{StaticResource StatValue}" FontSize="14" Margin="0,5,0,0" Text="{Binding CiText}"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource StatTile}">
                <StackPanel>
                    <TextBlock Style="{StaticResource StatLabel}" Text="SURVIVAL"/>
                    <TextBlock Style="{StaticResource StatValue}" FontSize="19"
                               Foreground="{StaticResource SuccessBrush}" Text="{Binding SurvivalText}"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource StatTile}">
                <StackPanel>
                    <TextBlock Style="{StaticResource StatLabel}" Text="START/FINAL r"/>
                    <TextBlock Style="{StaticResource StatValue}" FontSize="19" Text="{Binding CorrelationText}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Full text summary -->
        <TextBlock Text="Details" FontWeight="SemiBold" Margin="0,16,0,6"
                   Foreground="{StaticResource TextSecondaryBrush}"/>
        <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12,10">
            <TextBlock Text="{Binding ResultsSummaryText}" TextWrapping="Wrap" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </Border>
    </StackPanel>
</UserControl>

